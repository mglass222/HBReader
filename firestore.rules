rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return verified() && request.auth.uid == userId;
    }

    function hasOptionalField(field) {
      return request.resource.data.keys().hasAny([field]);
    }

    function optionalString(field, maxLength) {
      return !hasOptionalField(field)
        || request.resource.data[field] == null
        || (request.resource.data[field] is string
          && request.resource.data[field].size() <= maxLength);
    }

    function optionalNonNegativeNumber(field, maxValue) {
      return !hasOptionalField(field)
        || request.resource.data[field] == null
        || (request.resource.data[field] is number
          && request.resource.data[field] >= 0
          && request.resource.data[field] <= maxValue);
    }

    function optionalBoolean(field) {
      return !hasOptionalField(field)
        || request.resource.data[field] == null
        || request.resource.data[field] is bool;
    }

    function optionalUsername() {
      return !hasOptionalField('username')
        || request.resource.data.username == null
        || (request.resource.data.username is string
          && request.resource.data.username.matches('^[A-Za-z0-9_]{3,20}$'));
    }

    function isValidQuestionSet(questionSet) {
      return questionSet in ['nat_hist_bee', 'us_hist_bee'];
    }

    function isValidStatus(status) {
      return status in ['correct', 'incorrect', 'skipped'];
    }

    function isValidTier(tier) {
      return tier in [
        'Bronze',
        'Silver',
        'Gold',
        'Platinum',
        'Diamond',
        'Master',
        'Grandmaster'
      ];
    }

    function isValidLeaderboardPeriod(period) {
      return period == 'allTime'
        || period.matches('^monthly-[0-9]{4}-[0-9]{2}$')
        || period.matches('^weekly-[0-9]{4}-W[0-9]{2}$')
        || period.matches('^daily-[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidProfile() {
      return request.resource.data.keys().hasOnly([
        'username',
        'firstName',
        'lastName',
        'state',
        'school',
        'avatar',
        'totalPoints',
        'questionsAnswered',
        'currentStreak',
        'bestStreak',
        'createdAt',
        'accountDeleted',
        'deletedAt',
        'recoveryEmail',
        'recoveryEmailNormalized',
        'recoveredAt',
        'previousUserId'
      ])
      && optionalUsername()
      && optionalString('firstName', 50)
      && optionalString('lastName', 50)
      && optionalString('state', 20)
      && optionalString('school', 100)
      && optionalString('avatar', 16)
      && optionalString('recoveryEmail', 254)
      && optionalString('recoveryEmailNormalized', 254)
      && optionalString('previousUserId', 128)
      && optionalNonNegativeNumber('totalPoints', 10000000)
      && optionalNonNegativeNumber('questionsAnswered', 1000000)
      && optionalNonNegativeNumber('currentStreak', 1000000)
      && optionalNonNegativeNumber('bestStreak', 1000000)
      && optionalNonNegativeNumber('createdAt', 4102444800000)
      && optionalNonNegativeNumber('deletedAt', 4102444800000)
      && optionalNonNegativeNumber('recoveredAt', 4102444800000)
      && optionalBoolean('accountDeleted');
    }

    function isValidOwnerProfileWrite() {
      return isValidProfile()
        // recoveryEmail may only ever be the caller's own verified email
        && (!hasOptionalField('recoveryEmail')
          || request.resource.data.recoveryEmail == null
          || request.resource.data.recoveryEmail == request.auth.token.email)
        && (!hasOptionalField('accountDeleted')
          || request.resource.data.accountDeleted != true
          || request.resource.data.recoveryEmail == request.auth.token.email);
    }

    function canRecoverProfile() {
      return verified()
        && resource.data.accountDeleted == true
        && resource.data.recoveryEmail == request.auth.token.email;
    }

    function canRecoverUserData(userId) {
      return verified()
        && exists(/databases/$(database)/documents/users/$(userId)/profile/data)
        && get(/databases/$(database)/documents/users/$(userId)/profile/data).data.accountDeleted == true
        && get(/databases/$(database)/documents/users/$(userId)/profile/data).data.recoveryEmail == request.auth.token.email;
    }

    function isValidHistoryEntry() {
      return request.resource.data.keys().hasOnly([
        'id',
        'question',
        'answer',
        'status',
        'timestamp',
        'questionSet',
        'xpEligible'
      ])
      && request.resource.data.id is string
      && request.resource.data.id.size() <= 40
      && request.resource.data.question is string
      && request.resource.data.question.size() <= 12000
      && request.resource.data.answer is string
      && request.resource.data.answer.size() <= 4000
      && request.resource.data.timestamp is number
      && request.resource.data.timestamp >= 0
      && request.resource.data.timestamp <= 4102444800000
      && isValidStatus(request.resource.data.status)
      && isValidQuestionSet(request.resource.data.questionSet)
      // XP-eligibility flag written by the client for the scoring function;
      // server-owned markers (scoredAt/xpAwarded) stay outside the allowlist.
      && optionalBoolean('xpEligible');
    }

    function isValidLeaderboardRanking() {
      return request.resource.data.keys().hasOnly([
        'username',
        'avatar',
        'points',
        'questionsAnswered',
        'level',
        'tier',
        'lastUpdated'
      ])
      && request.resource.data.username is string
      && request.resource.data.username.matches('^[A-Za-z0-9_]{3,20}$')
      && optionalString('avatar', 16)
      && request.resource.data.points is number
      && request.resource.data.points >= 0
      && request.resource.data.points <= 10000000
      && request.resource.data.questionsAnswered is number
      && request.resource.data.questionsAnswered >= 0
      && request.resource.data.questionsAnswered <= 1000000
      && request.resource.data.lastUpdated is number
      && request.resource.data.lastUpdated >= 0
      && request.resource.data.lastUpdated <= 4102444800000
      && (!hasOptionalField('level')
        || (request.resource.data.level is number
          && request.resource.data.level >= 1
          && request.resource.data.level <= 100))
      && (!hasOptionalField('tier')
        || (request.resource.data.tier is string && isValidTier(request.resource.data.tier)));
    }

    function isValidRecoveryDoc() {
      return request.resource.data.keys().hasOnly([
        'oldUserId',
        'recoveryEmail',
        'recoveryEmailNormalized',
        'createdAt'
      ])
      && request.resource.data.oldUserId is string
      && request.resource.data.oldUserId == request.auth.uid
      && request.resource.data.recoveryEmail is string
      && request.resource.data.recoveryEmail == request.auth.token.email
      && request.resource.data.recoveryEmailNormalized is string
      && request.resource.data.recoveryEmailNormalized.size() <= 254
      && request.resource.data.createdAt is number
      && request.resource.data.createdAt >= 0
      && request.resource.data.createdAt <= 4102444800000;
    }

    match /users/{userId}/profile/data {
      allow read: if isOwner(userId) || canRecoverProfile();
      allow create, update: if isOwner(userId) && isValidOwnerProfileWrite();
      allow delete: if isOwner(userId) || canRecoverProfile();
    }

    match /users/{userId}/history/{historyId} {
      allow read: if isOwner(userId) || canRecoverUserData(userId);
      allow create, update: if isOwner(userId) && isValidHistoryEntry();
      allow delete: if isOwner(userId) || canRecoverUserData(userId);
    }

    match /leaderboards/{period}/rankings/{userId} {
      allow read: if isValidLeaderboardPeriod(period);
      // Points can never exceed the profile's totalPoints. This bounds (but
      // does not eliminate) client-side score forgery; truly authoritative
      // scoring requires a server-side path (e.g. Cloud Functions).
      allow create, update: if isOwner(userId)
        && isValidLeaderboardPeriod(period)
        && isValidLeaderboardRanking()
        && request.resource.data.points
          <= get(/databases/$(database)/documents/users/$(userId)/profile/data).data.totalPoints;
      allow delete: if isOwner(userId) && isValidLeaderboardPeriod(period);
    }

    match /accountRecovery/{recoveryId} {
      allow read, delete: if verified()
        && resource.data.recoveryEmail == request.auth.token.email;
      // The document ID must be the caller's own lowercased email, so no
      // user can plant or overwrite another user's recovery document.
      allow create, update: if verified()
        && isValidRecoveryDoc()
        && recoveryId == request.auth.token.email.lower();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
